# Copy to .env locally; never commit or share the real .env.
# Current frozen evidence-v3 classifier settings.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here
USE_EXAMPLES=false

# Local safety limits, not a guarantee of provider quota or pricing.
MAX_INPUT_TOKENS=225000
GEMINI_RPM_LIMIT=15
GEMINI_INPUT_TPM_LIMIT=250000
GEMINI_RPD_LIMIT=500
